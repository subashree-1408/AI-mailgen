PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET=replace_with_secure_jwt_secret_at_least_32_chars
TOKEN_ENCRYPTION_KEY=replace_with_64_character_hex_key_for_aes_256_gcm
CORS_ORIGIN=http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 (for Gmail API integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback

# Brevo (Sendinblue) Integration
BREVO_API_KEY=your_brevo_api_key_or_smtp_key
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
BREVO_SENDER_NAME=Your Name
BREVO_WEBHOOK_SECRET=your_optional_webhook_secret
